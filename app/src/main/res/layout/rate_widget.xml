<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ultra-ligero: sin layouts anidados complejos para minimizar GPU en SystemUI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_data"
        android:textSize="26sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        tools:text="36.50 Bs/USD" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_loading"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:layout_marginBottom="10dp"
        tools:text="Actualizado: 14:30" />

    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/widget_refresh"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_button_text"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/widget_button_background" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">DivTrack</string>

    <!--
      Textos del instalador de actualizaciones (`UpdateInstaller`, en este módulo).

      Viven AQUÍ y no en :presentation porque `android.nonTransitiveRClass=true`: el `R`
      de :app solo contiene recursos de :app, y estos mensajes los lanza este módulo (el
      FileProvider y el manifiesto también son de aquí). Un string de :presentation no
      resuelve desde el código de :app y la compilación falla.
    -->
    <string name="settings_update_apk_missing">El archivo descargado ya no está en el dispositivo</string>
    <string name="settings_update_no_installer">No hay un instalador disponible en este dispositivo</string>
    <string name="settings_update_allow_install">Activa «Permitir desde esta fuente» y vuelve a tocar «Instalar actualización»</string>

    <!--
      Textos del widget (viven en :app porque usa nonTransitiveRClass=true).
    -->
    <string name="widget_title">Dólar Oficial</string>
    <string name="widget_description">Muestra la tasa del dólar oficial y su hora de actualización</string>
    <string name="widget_loading">Cargando…</string>
    <string name="widget_refresh">Actualizar</string>
    <string name="widget_updated">Actualizado: %1$s</string>
    <string name="widget_no_data">Sin datos</string>

    <!--
      Textos de la notificación persistente (viven en :app porque usa nonTransitiveRClass=true).
    -->
    <string name="notification_channel_name">Tasas de cambio</string>
    <string name="notification_channel_description">Muestra las tasas de cambio en una notificación permanente</string>
    <string name="notification_title">DivTrack · Tasas de cambio</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de seguridad de red.

  DivTrack habla con cinco endpoints públicos y todos son HTTPS:

      · https://ve.dolarapi.com/     (oficial BCV + paralelo)
      · https://api.yadio.io/        (respaldo del paralelo)
      · https://open.er-api.com/     (respaldo del oficial)
      · https://rates.dolarvzla.com/ (CDN estático con el cierre oficial del BCV)
      · https://api.github.com/      (release publicado, para el módulo de actualizaciones)

  `cleartextTrafficPermitted="false"` cierra la puerta a HTTP en claro para todas las
  direcciones, no solo para esas dos: si algún día se cambia un baseUrl a un host con
  `http://`, el fallo aparece en el primer intento (IOException de cleartext bloqueado) en
  lugar de mandar las tasas por la red sin cifrar. Es la causa número uno de "la API no
  responde" después de una migración de dominio, y aquí queda descartada por diseño.

  No se fijan anclas de confianza propias a propósito: los certificados del sistema son
  suficientes y añadir un pin propio rompería la app el día que el proveedor renueve su
  certificado.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
